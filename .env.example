# Database (isi sesuai kredensial PostgreSQL kamu — dari Railway/Render/Supabase)
DATABASE_URL=postgresql://user:password@localhost:5432/rumahku

# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia
JWT_EXPIRES_IN=7d

# CORS - domain frontend yang diizinkan akses API
FRONTEND_ORIGIN=http://localhost:5173
